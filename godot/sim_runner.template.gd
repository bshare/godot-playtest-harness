extends SceneTree
## sim_runner — the headless tier of the harness.
##
##   godot --headless -s res://tools/sim/sim_runner.gd -- --runs=100 --seed=1 --policy=random
##
## The browser tier answers "what does a player see". This tier answers "what
## happens across a thousand runs", and it does it with no browser, no canvas,
## no screenshots, and no Playwright — roughly three orders of magnitude cheaper
## per run. Both tiers drive the SAME game code through the SAME adapter, which
## is the point: a balance number measured here is a number about the real game,
## not about a decoupled simulation of it.
##
## WHY A SceneTree SCRIPT AND NOT A DECOUPLED MODEL.
## `-s` runs this instead of the main scene, but the engine still instantiates
## every autoload into `root` — verified. So the real singletons, the real turn
## resolution, and the real RNG are all live; only rendering and input are gone.
## A "pure logic" simulation would have been a second implementation to keep in
## sync, and it would have drifted.
##
## TEMPLATE. Copy to res://tools/sim/sim_runner.gd. You do NOT edit this file
## per game — everything game-specific lives in the adapter (see ADAPTER
## CONTRACT below), which is the same contract DebugBridge delegates to.

## Bump when the JSONL record shape changes. batch.mjs refuses a mismatch
## rather than aggregating fields whose meaning may have moved.
const SIM_SCHEMA_VERSION: int = 1

## Where the game's adapter lives. One fixed path, so the runner needs no config.
const ADAPTER_PATH: String = "res://tools/sim/playtest_core.gd"

# =============================================================================
# ADAPTER CONTRACT — implement these in playtest_core.gd
# =============================================================================
#
#   reset(seed: int) -> void
#       Start a fresh run reproducibly. Every RNG the game touches must be
#       seeded from `seed` here. If any subsystem re-randomises itself later
#       (a map generator calling randomize() mid-generation is the common
#       case) the run is NOT reproducible and batch results are noise — find
#       it before trusting a single number out of this tier.
#
#   build_state() -> Dictionary
#       The same state DebugBridge.dump_state returns. Same function, not a
#       parallel one — a parity check between the tiers is only meaningful if
#       both read the identical builder.
#
#   legal_moves() -> Array[Dictionary]
#       [{ "action": "move", "args": {...} }, ...] — legal RIGHT NOW.
#       Required here, unlike in the bridge where it is optional: a policy
#       with no legal-move list can only guess, and a run of guesses measures
#       the guesser.
#
#   dispatch(action: String, args: Dictionary) -> Dictionary
#       Apply one action. Return at least {"success": bool}. Must report real
#       failure; an adapter that returns success unconditionally turns every
#       aggregate downstream into a fiction.
#
#   is_over() -> bool
#   outcome() -> String        e.g. "WON" | "LOST" | "TIMEOUT"
#   state_hash() -> int        stable over everything that must reproduce
#
# FRAME-DRIVEN LOGIC — READ THIS IF YOUR TURNS RESOLVE IN _process/_physics_process.
# The run loop below dispatches actions back-to-back inside one resumed
# coroutine: BY DEFAULT THE ENGINE DOES NOT TICK BETWEEN TURNS. A game whose
# turn resolution happens in _process, _physics_process, timers, or tweens will
# not advance between dispatches — state_hash stays flat and this tier silently
# measures nothing (worst-case: it LOOKS like a clean batch). Either make
# dispatch() resolve the turn synchronously (the recommended adapter shape), or
# pass --ticks-per-turn=N to await N physics frames after every successful
# dispatch. The runner warns loudly when a run's state hash never changes.
#
# =============================================================================

var _adapter: Object
var _opts: Dictionary = {}
var _out_file: FileAccess
## Set by _fatal(). quit(1) does not stop a resumed coroutine mid-flight, so
## every loop checks this flag — without it, a fatal fired once per remaining
## turn and the runner kept emitting records for a run it had already declared
## dead.
var _aborted: bool = false


func _initialize() -> void:
	_opts = _parse_args(OS.get_cmdline_user_args())

	var script: Resource = load(ADAPTER_PATH)
	if script == null:
		_fatal("no adapter at %s — see ADAPTER CONTRACT in sim_runner.gd" % ADAPTER_PATH)
		return
	_adapter = script.new()
	if _adapter is Node:
		root.add_child(_adapter)

	# Autoloads are instantiated before this script runs, but their _ready() has
	# not fired yet — reading game state in _initialize() gets you a half-built
	# world with null everywhere. One frame fixes it. (Cost of learning this:
	# a probe run that reported `player: <null>` and looked like a broken game.)
	await process_frame

	var out_path: String = _opts.get("out", "")
	if out_path != "":
		_out_file = FileAccess.open(out_path, FileAccess.WRITE)
		if _out_file == null:
			_fatal("cannot write %s" % out_path)
			return

	var runs: int = int(_opts.get("runs", 1))
	# int("abc") is 0, so a typo'd --runs used to exit 0 having emitted nothing —
	# a clean-looking batch that measured nothing. Zero or negative is a refusal.
	if runs <= 0:
		_fatal("--runs must be a positive integer (got \"%s\")" % str(_opts.get("runs", 1)))
		return
	var base_seed: int = int(_opts.get("seed", 1))
	var policy: String = str(_opts.get("policy", "random"))
	var max_turns: int = int(_opts.get("max-turns", 2000))
	var ticks_per_turn: int = int(_opts.get("ticks-per-turn", 0))
	var scripted: Array = _load_script_file(str(_opts.get("script", "")))
	if _aborted:
		return

	# N runs in ONE process. Engine boot dominates the cost of a single run, so
	# batching in-process is the difference between ~2 runs/sec and ~100/sec.
	# It also means run K+1 inherits whatever run K left in a singleton — which
	# is exactly the cross-run contamination the adapter's reset() must kill,
	# and running a batch is how you find out that it doesn't.
	for i in runs:
		var seed_value: int = base_seed + i
		var record: Dictionary = await _run_one(seed_value, policy, max_turns, scripted, ticks_per_turn)
		if _aborted:
			return
		_emit(record)

	if _out_file != null:
		_out_file.close()
	quit(0)


func _run_one(seed_value: int, policy: String, max_turns: int, scripted: Array, ticks_per_turn: int) -> Dictionary:
	var started_usec: int = Time.get_ticks_usec()
	_adapter.reset(seed_value)
	await process_frame

	var turns: int = 0
	var rejected: int = 0
	var trace: Array = []
	var error: String = ""
	# For the flat-hash diagnostic below: a run whose state never moves is the
	# signature of frame-driven turn logic on the default no-tick loop.
	var first_hash: int = 0
	var hash_moved: bool = false

	while turns < max_turns:
		if _aborted:
			error = "aborted"
			break
		if _adapter.is_over():
			break

		var moves: Array = _adapter.legal_moves()
		var choice: Dictionary = _choose(policy, moves, scripted, turns, seed_value)
		if choice.is_empty():
			# No legal move and not over. Two distinct stories share this shape
			# and the record must tell them apart: "the game is stuck" versus
			# "the script ran out of entries" — lumping scripted truncation into
			# stuck-game stats poisons the aggregate for both.
			error = ("script_exhausted" if policy == "scripted" and turns >= scripted.size() else "no_legal_move")
			break

		var result: Dictionary = _adapter.dispatch(
			str(choice.get("action", "")), choice.get("args", {})
		)
		if not bool(result.get("success", false)):
			rejected += 1
			# A policy picking from legal_moves() should never be rejected. If
			# this climbs, legal_moves() is lying and every aggregate built on
			# this tier is suspect.
			if rejected > 32:
				error = "too_many_rejections"
				break
		else:
			# --ticks-per-turn: let the engine actually run between dispatches,
			# for games whose turn resolution lives in _process/_physics_process,
			# timers or tweens (see FRAME-DRIVEN LOGIC in the adapter contract).
			# Awaited BEFORE the hash so the hash sees the turn's settled state.
			for _t in ticks_per_turn:
				await physics_frame
			turns += 1
			var h: int = _adapter.state_hash()
			if turns == 1:
				first_hash = h
			elif h != first_hash:
				hash_moved = true
			# The per-turn hash is what makes a trace checkable rather than just
			# replayable: parity against the browser tier reports the FIRST turn
			# the two diverge, and a final-state-only comparison would say
			# "different" without saying when.
			trace.append({
				"turn": turns,
				"action": choice.get("action", ""),
				"args": choice.get("args", {}),
				"hash": h,
			})

	# THE FLAT-HASH DIAGNOSTIC. Turns dispatched, state never changed once: on a
	# frame-driven game with the default no-tick loop this tier measures nothing
	# while producing a clean-looking batch — the worst failure mode available.
	# Loud on stderr, not fatal: a game could legitimately no-op a short run.
	if turns >= 2 and not hash_moved and ticks_per_turn == 0:
		printerr("[sim_runner] WARNING: %d turns dispatched and state_hash never changed (seed %d). " % [turns, seed_value]
			+ "If this game resolves turns in _process/_physics_process, the default loop never ticks the engine — "
			+ "pass --ticks-per-turn=N or make dispatch() resolve synchronously.")

	# Off-by-one guard: the while loop above checks is_over() BEFORE each turn,
	# not after. A run whose deciding action is exactly turn max_turns exits the
	# loop on the turn-count condition without ever re-checking is_over() on the
	# now-finished game, and `turns >= max_turns` alone would misreport that as
	# TIMEOUT — silently deflating win_rate_pct precisely when someone tunes a
	# tight cap. Re-check is_over() here so a game that finished on the last
	# allowed turn is still scored as finished, not timed out.
	var timed_out: bool = turns >= max_turns and not _adapter.is_over()

	var final_state: Dictionary = _adapter.build_state()
	return {
		"version": SIM_SCHEMA_VERSION,
		"seed": seed_value,
		"policy": policy,
		"turns": turns,
		"rejected": rejected,
		"outcome": ("TIMEOUT" if timed_out else _adapter.outcome()),
		"error": error,
		"state_hash": _adapter.state_hash(),
		"duration_ms": (Time.get_ticks_usec() - started_usec) / 1000.0,
		"state": final_state,
		# The action list is what makes a run reproducible in the BROWSER tier:
		# an interesting sim outcome becomes a scenario you can watch.
		"trace": (trace if bool(_opts.get("trace", false)) else []),
	}


# =============================================================================
# Policies
# =============================================================================
#
# Generic policies live here because they are game-agnostic by construction —
# they only ever see legal_moves(). A game wanting a smarter policy (a greedy
# optimiser, a scripted opening) implements `policy(name) -> Callable` on its
# adapter; anything not handled below is delegated there.
#
# The measurement that matters is usually a RATIO between two policies, not one
# policy's absolute win rate: agent win rate does not transfer to humans, but
# "optimiser beats greedy by 2x" is a statement about the game's decision space.

func _choose(policy: String, moves: Array, scripted: Array, turn: int, seed_value: int) -> Dictionary:
	if moves.is_empty():
		return {}
	match policy:
		"random":
			# Seeded off the run seed, not the global RNG: the policy's choices
			# must not consume from the game's streams, or replaying the same
			# seed with a different policy would generate a different map.
			var rng := RandomNumberGenerator.new()
			rng.seed = hash([seed_value, turn])
			return moves[rng.randi_range(0, moves.size() - 1)]
		"first_legal":
			return moves[0]
		"scripted":
			if turn < scripted.size():
				return scripted[turn]
			return {}
		_:
			if _adapter.has_method("policy"):
				var fn: Callable = _adapter.policy(policy)
				if fn.is_valid():
					return fn.call(moves, turn)
			_fatal("unknown policy '%s'" % policy)
			return {}


# =============================================================================
# Plumbing
# =============================================================================

## `--runs=100 --policy=random --trace` → {"runs":"100","policy":"random","trace":true}
## Read from get_cmdline_user_args(), i.e. everything after a bare `--`, so
## nothing here can collide with an engine flag.
func _parse_args(argv: PackedStringArray) -> Dictionary:
	var out: Dictionary = {}
	for arg in argv:
		var a: String = arg.trim_prefix("--")
		if a.contains("="):
			var parts: PackedStringArray = a.split("=", true, 1)
			out[parts[0]] = parts[1]
		else:
			out[a] = true
	return out


func _load_script_file(path: String) -> Array:
	if path == "":
		return []
	var text: String = FileAccess.get_file_as_string(path)
	var parsed: Variant = JSON.parse_string(text)
	if parsed is Array:
		return parsed
	_fatal("--script must be a JSON array of {action,args}: %s" % path)
	return []


## One JSON object per line. Line-delimited on purpose: a batch killed halfway
## still leaves every completed run readable, and `tail -f` shows progress.
func _emit(record: Dictionary) -> void:
	var line: String = JSON.stringify(_jsonable(record))
	if _out_file != null:
		_out_file.store_line(line)
	else:
		print(line)


## JSON has no representation for NaN/Infinity — JSON.stringify emits the bare
## tokens `nan`/`inf`, which is not valid JSON and crashes the strict JS-side
## parse in batch.mjs for a value that is a normal outcome of game math. Every
## other emitter in this repo (both bridges, the TCP template) already routes
## through this same transform; the JSONL channel gets it too.
func _jsonable(value: Variant, depth: int = 0) -> Variant:
	if depth > 32:
		# A Dictionary/Array containing itself (legal in GDScript) would recurse
		# forever and stack-overflow the whole bridge mid-dump; depth-cap instead.
		return "<max depth exceeded - possible cycle>"
	match typeof(value):
		TYPE_FLOAT:
			if is_nan(value) or is_inf(value):
				return null
			return value
		TYPE_ARRAY:
			var out_arr: Array = []
			for v in value:
				out_arr.append(_jsonable(v, depth + 1))
			return out_arr
		TYPE_DICTIONARY:
			var out_dict: Dictionary = {}
			for k in value:
				out_dict[str(k)] = _jsonable(value[k], depth + 1)
			return out_dict
		_:
			return value


func _fatal(message: String) -> void:
	# Once. quit(1) does not stop a resumed coroutine, so without the flag a
	# fatal inside the turn loop repeated its message every remaining turn while
	# the runner kept emitting records for a dead run. Callers check _aborted.
	if _aborted:
		return
	_aborted = true
	printerr("[sim_runner] %s" % message)
	if _out_file != null:
		_out_file.close()
		_out_file = null
	quit(1)
